# Copy to .env and fill in.

# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Local clone of your data repository (e.g. link-vault-data)
#   Windows: LV_DATA_DIR=C:\Users\you\link-vault-data
#   Mac:     LV_DATA_DIR=/Users/you/link-vault-data
LV_DATA_DIR=

# Model used for analysis. claude-haiku-5-5 is ~40x cheaper and fine for categorizing.
LV_MODEL=claude-opus-5-5

# Max links analyzed per run (the rest wait for the next run)
LV_MAX_PER_RUN=60
