# Copy to .env and fill in.

# Local clone of your data repository (e.g. link-vault-data)
#   Windows: LV_DATA_DIR=C:\Users\you\link-vault-data
#   Mac:     LV_DATA_DIR=/Users/you/link-vault-data
LV_DATA_DIR=

# How links are analyzed:
#   claude-code (default) = Claude Code CLI logged in with your Pro/Max plan. No API key, no extra charge.
#   api                   = Claude API, billed per use. Needs ANTHROPIC_API_KEY below.
LV_BACKEND=claude-code

# Model. claude-code: opus / sonnet / haiku (haiku uses the least of your plan's limits)
#        api:         claude-opus-5-5 / claude-haiku-5-5 ...
LV_MODEL=opus

# Full path to the claude command, if the scheduler can't find it
#   Windows: LV_CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
#   Mac:     LV_CLAUDE_BIN=/Users/you/.local/bin/claude
# LV_CLAUDE_BIN=

# Max links analyzed per run (the rest wait for the next run)
LV_MAX_PER_RUN=60

# Only for LV_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
